OPENAI_API_KEY=""
DEBUG=True
SECRET_KEY=""
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------- CACHÉ ------------------------------------------
# Si REDIS_URL está definida se usa Redis (producción multi-worker).
# Si está vacía se usa caché local en memoria (desarrollo de un solo worker).
REDIS_URL=""
REDIS_DB=0
CACHE_KEY_PREFIX="mcf"

# TTL (segundos) de los distintos niveles de caché
CACHE_TIMEOUT=300
CACHE_TTL_CORTO=60
CACHE_TTL_MEDIO=300
CACHE_TTL_LARGO=1800

# ------------------------- BASE DE DATOS ----------------------------------
# DB_ENGINE=postgresql activa PostgreSQL (producción). Por defecto usa SQLite.
DB_ENGINE=sqlite
DB_NAME=mycolegiofavorito
DB_USER=""
DB_PASSWORD=""
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ------------------------- COMUNICACIONES ----------------------------------
# Correo: si EMAIL_HOST está vacío se usa el backend de consola (imprime en
# terminal). En producción configura un SMTP real.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL="notificaciones@mi-colegio.com"

# WhatsApp: URL del gateway HTTP (Twilio, Meta Cloud API, etc.). Si está
# vacía los envíos se simulan (solo logs) para probar en desarrollo.
WHATSAPP_GATEWAY_URL=""
WHATSAPP_GATEWAY_TOKEN=""
WHATSAPP_FROM=""
